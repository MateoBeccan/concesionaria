<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260501100000-1-add-cliente-tipo-persona" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="cliente"/>
        <not>
          <columnExists tableName="cliente" columnName="tipo_persona"/>
        </not>
      </and>
    </preConditions>
    <addColumn tableName="cliente">
      <column name="tipo_persona" type="varchar(255)"/>
    </addColumn>
  </changeSet>

  <changeSet id="20260501100000-2-backfill-cliente-tipo-persona" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="cliente"/>
        <columnExists tableName="cliente" columnName="tipo_persona"/>
      </and>
    </preConditions>
    <sql>UPDATE cliente SET tipo_persona = 'FISICA' WHERE tipo_persona IS NULL OR tipo_persona = '';</sql>
  </changeSet>

  <changeSet id="20260501100000-3-cliente-tipo-persona-not-null" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="cliente"/>
        <columnExists tableName="cliente" columnName="tipo_persona"/>
        <sqlCheck expectedResult="0">SELECT COUNT(*) FROM cliente WHERE tipo_persona IS NULL OR tipo_persona = ''</sqlCheck>
      </and>
    </preConditions>
    <addNotNullConstraint tableName="cliente" columnName="tipo_persona" columnDataType="varchar(255)"/>
  </changeSet>

  <changeSet id="20260501100000-4-add-venta-vehiculo-relation-column" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="venta"/>
        <tableExists tableName="vehiculo"/>
        <not>
          <columnExists tableName="venta" columnName="vehiculo_id"/>
        </not>
      </and>
    </preConditions>
    <addColumn tableName="venta">
      <column name="vehiculo_id" type="bigint"/>
    </addColumn>
  </changeSet>

  <changeSet id="20260501100000-5-add-venta-vehiculo-relation-fk" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="venta"/>
        <tableExists tableName="vehiculo"/>
        <columnExists tableName="venta" columnName="vehiculo_id"/>
        <not>
          <foreignKeyConstraintExists foreignKeyName="fk_venta__vehiculo_id"/>
        </not>
      </and>
    </preConditions>
    <addForeignKeyConstraint
      baseTableName="venta"
      baseColumnNames="vehiculo_id"
      constraintName="fk_venta__vehiculo_id"
      referencedTableName="vehiculo"
      referencedColumnNames="id"/>
  </changeSet>

  <changeSet id="20260501100000-6-add-venta-vehiculo-relation-index" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="venta"/>
        <columnExists tableName="venta" columnName="vehiculo_id"/>
        <not>
          <indexExists tableName="venta" indexName="idx_venta__vehiculo_id"/>
        </not>
      </and>
    </preConditions>
    <createIndex tableName="venta" indexName="idx_venta__vehiculo_id">
      <column name="vehiculo_id"/>
    </createIndex>
  </changeSet>

  <changeSet id="20260501100000-7-venta-vehiculo-not-null-when-safe" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="venta"/>
        <columnExists tableName="venta" columnName="vehiculo_id"/>
        <sqlCheck expectedResult="0">SELECT COUNT(*) FROM venta WHERE vehiculo_id IS NULL</sqlCheck>
      </and>
    </preConditions>
    <addNotNullConstraint tableName="venta" columnName="vehiculo_id" columnDataType="bigint"/>
  </changeSet>

  <changeSet id="20260501100000-8-create-venta-historial" author="codex">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="venta_historial"/>
      </not>
    </preConditions>
    <createTable tableName="venta_historial">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="venta_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="fecha" type="${datetimeType}">
        <constraints nullable="false"/>
      </column>
      <column name="estado_anterior" type="varchar(255)"/>
      <column name="estado_nuevo" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="accion" type="varchar(100)">
        <constraints nullable="false"/>
      </column>
      <column name="detalle" type="varchar(500)"/>
      <column name="usuario" type="varchar(50)"/>
    </createTable>
  </changeSet>

  <changeSet id="20260501100000-9-add-venta-historial-fk" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="venta_historial"/>
        <tableExists tableName="venta"/>
        <columnExists tableName="venta_historial" columnName="venta_id"/>
        <not>
          <foreignKeyConstraintExists foreignKeyName="fk_venta_historial__venta_id"/>
        </not>
      </and>
    </preConditions>
    <addForeignKeyConstraint
      baseTableName="venta_historial"
      baseColumnNames="venta_id"
      constraintName="fk_venta_historial__venta_id"
      referencedTableName="venta"
      referencedColumnNames="id"/>
  </changeSet>

  <changeSet id="20260501100000-10-add-venta-historial-index" author="codex">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="venta_historial"/>
        <columnExists tableName="venta_historial" columnName="venta_id"/>
        <not>
          <indexExists tableName="venta_historial" indexName="idx_venta_historial__venta_id"/>
        </not>
      </and>
    </preConditions>
    <createIndex tableName="venta_historial" indexName="idx_venta_historial__venta_id">
      <column name="venta_id"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
